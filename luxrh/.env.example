# LuxRH — modèle de configuration locale
#
# Copier ce fichier sous le nom `.env.local` dans le même répertoire, puis
# renseigner les valeurs. `.env.local` est exclu du contrôle de version par le
# `.gitignore` de la racine : ce dépôt est public, aucune valeur réelle ne doit
# y figurer.
#
#     cp luxrh/.env.example luxrh/.env.local
#
# Les deux interfaces et l'ensemble des outils lisent ce fichier unique. Une
# variable d'environnement du système l'emporte toujours sur la valeur inscrite
# ici : c'est ce qui permet à une chaîne d'intégration continue de fournir ses
# propres identifiants sans écrire de fichier.
#
# Aucune valeur n'est devinée. Une variable absente provoque un message explicite
# qui nomme la variable manquante, jamais un comportement par défaut silencieux.

# ============================================================ Supabase (requis)
#
# Tableau de bord Supabase > Project Settings > API. La clé « publishable »
# (anon) est conçue pour être exposée au navigateur : c'est la sécurité au
# niveau des lignes (RLS) qui protège les données, jamais le secret de la clé.
# Ne jamais placer ici la clé « service_role », qui contourne la RLS.
VITE_SUPABASE_URL=https://<reference-du-projet>.supabase.co
VITE_SUPABASE_ANON_KEY=<cle-publishable>

# ====================================================== comptes de démonstration
#
# Utilisés par les six suites de tests. Les adresses de courriel ne sont pas des
# secrets et figurent dans `luxrh/tests/config.mjs` ; les mots de passe viennent
# uniquement d'ici.
#
#   demo@luxrh.lu    gestionnaire — accès à l'ensemble de son périmètre
#   marta@luxrh.lu   salariée     — ne doit voir que son propre dossier
#   autre@luxrh.lu   autre organisation — sert à vérifier le cloisonnement
LUXRH_MANAGER_PASSWORD=<mot-de-passe-du-gestionnaire>
LUXRH_EMPLOYEE_PASSWORD=<mot-de-passe-de-la-salariee>
LUXRH_OTHER_PASSWORD=<mot-de-passe-de-l-autre-organisation>

# ========================================================== compte administrateur
#
# Requis par les outils qui lisent le catalogue système : `fetch_catalogue.py`,
# `dump_migrations.py`, `verifier_coherence.py`. Ces fonctions sont réservées aux
# administrateurs d'organisation.
#
# Le compte se crée par `fn_create_app_user(identifiant, courriel, mot_de_passe,
# nom_complet, est_admin)`, qui applique bcrypt au moment de l'appel. Le mot de
# passe ne transite jamais par le dépôt.
#
# À défaut, les outils se rabattent sur demo@luxrh.lu / LUXRH_MANAGER_PASSWORD.
LUXRH_ADMIN_EMAIL=<courriel-de-l-administrateur>
LUXRH_ADMIN_PASSWORD=<mot-de-passe-de-l-administrateur>

# ================================================= base cible (Oracle ou MySQL)
#
# L'application Streamlit accepte `-- --db supabase|oracle|mysql`. À défaut
# d'argument, LUXRH_DB fait foi. Seul PostgreSQL porte le moteur de règles ; sur
# les autres bases, toute évaluation de règle lève `EngineUnavailable` — un refus
# explicite valant mieux qu'un résultat approximatif.
#
# LUXRH_DSN prend la forme attendue par le pilote : pour Oracle,
# `hote:port/service` ; pour MySQL, `hote:port/base`.
LUXRH_DB=supabase
LUXRH_DSN=<hote>:<port>/<service-ou-base>
LUXRH_DB_USER=<utilisateur>
LUXRH_DB_PASSWORD=<mot-de-passe>

# ============================================================ liens et services
#
# Adresse publique de l'application, utilisée dans les courriels de confirmation
# d'inscription et de réinitialisation de mot de passe.
LUXRH_APP_URL=http://localhost:5173

# Clé du service de calcul d'itinéraires, lue par la fonction de calcul des
# distances de trajet. Sans elle, `distances_trajet` ne se remplit pas et le
# calcul d'indemnité kilométrique déclare la donnée manquante au lieu de
# l'estimer.
DISTANCE_API_KEY=<cle-du-service-d-itineraires>

# ====================================================== journalisation autonome
#
# Chaîne de connexion utilisée par `dblink` pour écrire au registre des accès
# dans une transaction autonome — l'équivalent PostgreSQL de
# `PRAGMA AUTONOMOUS_TRANSACTION`. Sans elle, la trace de lecture est annulée
# avec la transaction qu'elle documente, ce qui la rend inutile en cas d'erreur.
#
# Cette valeur n'est pas lue depuis ce fichier : elle est stockée dans la table
# `secrets_application`, sous la clé `dblink_conninfo`, et n'est accessible
# qu'aux fonctions `security definer` du moteur. Elle figure ici pour mémoire.
# dblink_conninfo=host=... port=5432 dbname=postgres user=... password=...
