# LuxRH — configuration de l'infrastructure conteneurisée
#
# Copier ce fichier en `.env` à la racine du dépôt, puis ajuster. `.env` est
# exclu du contrôle de version : ce dépôt est public.
#
#     cp .env.example .env
#
# Docker Compose lit automatiquement le `.env` placé à côté du
# `docker-compose.yml` — aucune option `--env-file` n'est nécessaire.
#
# DEUX FICHIERS, DEUX RÔLES
# --------------------------
#   .env              (ici)  — l'infrastructure : ports, conteneurs, base Oracle
#   luxrh/.env.local         — l'application : Supabase, comptes de démonstration
#
# Ils ne se recouvrent pas. Le premier décrit où les choses écoutent, le second
# ce à quoi l'application se connecte.

# ============================================================ ports de l'hôte
#
# CHAQUE PORT EXPOSÉ EST DÉFINI ICI, ET NULLE PART AILLEURS.
#
# Un conflit sur la machine hôte se règle en changeant une valeur de ce fichier,
# sans toucher au `docker-compose.yml` ni à un Dockerfile.
#
# Les valeurs par défaut évitent délibérément les ports usuels. Relevé sur le
# poste de développement le 14 septembre 2026, étaient DÉJÀ OCCUPÉS :
#
#     3000  (API Node par défaut)     5173  (Vite par défaut)
#     8501  (Streamlit par défaut)    24642
#
# D'où le choix d'un bloc libre en 25xxx, dont les deux derniers chiffres
# rappellent le port usuel du service : 25521 pour Oracle (1521), 25173 pour
# Vite (5173), 25501 pour Streamlit (8501).
#
# Avant de changer une valeur, vérifier qu'elle est libre :
#     PowerShell : Get-NetTCPConnection -State Listen | ? LocalPort -eq 25521
#     WSL        : ss -ltn | grep 25521

ORACLE_PORT=25521          # écoute SQL*Net d'Oracle sur l'hôte
ORACLE_EM_PORT=25500       # Enterprise Manager Express
STREAMLIT_PORT=25501       # interface Streamlit
API_PORT=25173             # interface React servie par Vite

# ====================================================== ports dans le conteneur
#
# Rarement à changer : ce sont les ports standards à l'intérieur des images.
# Ils restent paramétrables pour le cas où une image les modifierait.

ORACLE_CONTAINER_PORT=1521
ORACLE_EM_CONTAINER_PORT=5500
STREAMLIT_CONTAINER_PORT=8501
API_CONTAINER_PORT=5173

# ============================================================ base Oracle
#
# Image : Oracle Database Free. Le projet vise Oracle 26ai ; l'édition Free
# publiquement disponible est la 23ai, qui partage la syntaxe employée par
# `schema/oracle.sql` (BOOLEAN natif, INTERVAL, déclencheurs composés).
#
# ORACLE_PWD protège SYS, SYSTEM et PDBADMIN. Douze caractères au minimum,
# sans caractère que le shell interpréterait.

ORACLE_IMAGE=container-registry.oracle.com/database/free:latest
ORACLE_PWD=<mot-de-passe-oracle>
ORACLE_PDB=LUXRHPDB
ORACLE_CHARACTERSET=AL32UTF8

# Utilisateur applicatif créé au premier démarrage par docker/oracle-init/.
LUXRH_DB_USER=luxrh
LUXRH_DB_PASSWORD=<mot-de-passe-applicatif>

# Base visée par l'interface Streamlit : supabase | oracle | mysql.
# Seul PostgreSQL porte le moteur de règles ; sur les autres, toute évaluation
# de règle lève `EngineUnavailable` — un refus explicite plutôt qu'un résultat
# approximatif.
LUXRH_DB=supabase

# ====================================================== limites de ressources
#
# Un conteneur qui consomme toute la mémoire de l'hôte emporte les autres avec
# lui. Ces bornes l'en empêchent.
#
# ORACLE_SHM : la mémoire partagée. Oracle échoue au démarrage avec les 64 Mo
# que Docker attribue par défaut — l'erreur parle d'ORA-00845 et n'évoque rien.
ORACLE_SHM=2g
ORACLE_MEM_LIMIT=6g
STREAMLIT_MEM_LIMIT=1g
API_MEM_LIMIT=2g

# ============================================================ orchestration
#
# Préfixe des conteneurs, réseaux et volumes. Le garder évite qu'un autre
# projet du même hôte n'entre en collision.
COMPOSE_PROJECT_NAME=luxrh

# Où Oracle écrit ses fichiers de données. Chemin du système de fichiers LINUX
# de WSL, jamais un chemin monté depuis Windows (`/mnt/c/...`) : les entrées et
# sorties y sont dix fois plus lentes, et Oracle exige des verrous que le
# pilote 9p ne rend pas correctement.
ORACLE_DATA=./docker/volumes/oracle

# Utilisateur et groupe appliqués aux fichiers écrits par les conteneurs, pour
# qu'ils restent modifiables depuis WSL. `id -u` et `id -g` dans la distribution.
UID=1000
GID=1000
