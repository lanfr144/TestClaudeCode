# Dépendances
node_modules/
.venv/
__pycache__/
*.pyc

# Sorties de build
dist/
.vite/

# Documentation compilée — les sources Markdown de docs/ font foi,
# les PDF se régénèrent avec .claude/skills/pdf-writer/render_pdf.py
/docs/pdf/

# Secrets et configuration locale — ce dépôt est public
#
# La règle est prise par la négative : toute variante de `.env` est exclue, et
# seul le fichier modèle est réadmis explicitement. Un `.env.production` ou un
# `.env.oracle` créé plus tard est donc couvert sans qu'il faille y penser.
.env
.env.*
!.env.example
*.local

# Matériel cryptographique et identifiants, quelle qu'en soit la forme
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
credentials.json
service-account*.json
secrets/

# Jeux de données téléchargés — volumineux, et reconstituables depuis leur source
# publique par `tools/telecharger_donnees.py`. Le dépôt garde la référence et la
# licence, pas les octets.
/data/brut/

# Volumes et états des conteneurs Docker
/docker/volumes/
/docker/.env

# Scripts d'initialisation Oracle générés au démarrage : l'un porte le mot de
# passe applicatif, l'autre est une copie du schéma régénérable.
/docker/oracle-init/00_variables.sql
/docker/oracle-init/02_schema.sql

# Artefacts de l'outil de conception
.thumbnail

# Projet Node distinct, sans rapport avec LuxRH (plusieurs centaines de Mo).
video/

# Contenus sous licence — règle d'or, voir ~/.claude/CLAUDE.md
#
# Textes de loi, conventions collectives, barèmes : ces documents portent une
# licence et exigent une attribution. Ils ne sont PAS versionnés, même quand la
# licence l'autoriserait : une attribution se perd au premier fork, un texte est
# abrogé sans que la copie le signale, et un binaire supprimé reste dans tous
# les clones.
#
# Ce qui est versionné à la place : `docs/sources-legales.md`, le manifeste des
# références — ELI, licence, attribution, URL et empreinte —, régénéré par
# `tools/inventaire_sources.py`. Le répertoire local se reconstitue par
# `tools/telecharger_sources.py`.
/lois_et_règlements/
/lois&règlements/

# Archive des échanges de travail : journal local, pas un livrable.
/discussion/

# Rebuts d'éditeurs — voir ~/.claude/CLAUDE.md
#
# Les copies de secours de Word doublent le poids de l'historique et divergent
# en silence de l'original : on ne sait plus laquelle fait foi. Un document de
# travail se conserve par un commit, pas par une copie posée à côté.
*.wbk
~$*
*.tmp
*.bak
*.old
*.orig
*.rej
.~lock.*#
*.swp
*.swo
*~
.DS_Store
Thumbs.db
